# =============================================================================
# QUIZVERSE CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your actual production values.
# NEVER commit the real '.env' file with actual credentials to Git!
# =============================================================================

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Application Environment ('development' or 'production')
FLASK_ENV=production

# Flask Secret Key for Cryptographic Session Signing
# Generate a secure key in Python using: secrets.token_hex(32)
FLASK_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string

# Centralized Database File Path
# In production Linux deployments, set to e.g. /var/lib/quizverse/quiz.db
DATABASE_PATH=quiz.db

# Trusted Reverse Proxy Count (e.g. 1 when behind a single Nginx reverse proxy)
TRUSTED_PROXIES=1

# Optional: Allow 1-click fast-pass demo logins ('true' for academic evaluation only, 'false' in live production)
ALLOW_DEMO_LOGINS=false
